# QuantumLane environment template.
# Copy this file to .env and fill in the values. Never commit .env.
#
# Vars prefixed QL_ are read by both ingestion and api packages.
# Vars without a prefix are consumed by docker compose directly.

# --- Environment ---
QL_ENVIRONMENT=development          # development | staging | production
QL_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Postgres (app data) ---
POSTGRES_USER=quantumlane
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=quantumlane

# DSN used by all services to reach the main DB. Hostname 'postgres' resolves inside the compose network.
QL_POSTGRES_DSN=postgresql://quantumlane:change-me-please@postgres:5432/quantumlane

# --- Postgres (Dagster metadata, separate DB) ---
DAGSTER_POSTGRES_PASSWORD=change-me-too

# --- TTC GTFS-RT feeds ---
# These defaults point to the TTC's public endpoints. Override for testing.
# bustime.ttc.ca was retired in 2026; gtfsrt.ttc.ca is the replacement and
# `?format=binary` selects protobuf.
QL_TTC_VEHICLE_POSITIONS_URL=https://gtfsrt.ttc.ca/vehicles/position?format=binary
QL_TTC_TRIP_UPDATES_URL=https://gtfsrt.ttc.ca/trips/update?format=binary
QL_TTC_SERVICE_ALERTS_URL=https://gtfsrt.ttc.ca/alerts/all?format=binary
# Static schedule zip from Toronto's CKAN open-data portal (the old
# opendata.toronto.ca path no longer resolves).
QL_TTC_STATIC_GTFS_URL=https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/7795b45e-e65a-4465-81fc-c36b9dfff169/resource/cfb6b2b8-6191-41e3-bda1-b175c51148cb/download/TTC%20Routes%20and%20Schedules%20Data.zip

# --- HTTP client ---
QL_HTTP_TIMEOUT_SECONDS=15
# User-Agent is not configurable here: it is quantumlane-ingestion/<package version>
# (+https://quantumlane.io), set in ingestion settings.py. The TTC WAF 403s generic
# Python User-Agents, so it must stay a product-identifying string.

# --- AWS S3 cold tier / backups (optional in dev) ---
# QL_S3_ACCESS_KEY_ID=
# QL_S3_SECRET_ACCESS_KEY=
# QL_S3_BUCKET=quantumlane
# QL_S3_REGION=us-east-1

# --- API ---
# Comma-separated list or JSON array, depending on how pydantic-settings is configured.
QL_CORS_ORIGINS=["http://localhost:8080","https://quantumlane.io"]
QL_RATE_LIMIT_PER_MINUTE=60

# --- Deployment (for the deploy script) ---
# DEPLOY_HOST=ql@quantumlane.io
